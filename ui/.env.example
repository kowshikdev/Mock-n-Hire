# Frontend (ui/) -- copy to ui/.env.local and fill in.

# Supabase project (client-side: the anon/publishable key, not the service
# role key -- this is exposed to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API base URL (api/api_service.py, deployed on Railway or run
# locally). Recruiter and student routes are both served from this one URL
# now (see api/CLAUDE.md) -- there is no separate second backend to point
# anywhere. Required in production: without it, every API call silently
# falls back to http://localhost:4000, which doesn't exist in a deployed
# visitor's browser.
NEXT_PUBLIC_API_URL=https://your-app.up.railway.app

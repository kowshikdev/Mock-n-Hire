# Merged backend (api/) -- recruiter ranking + candidate/interview routes run
# as one FastAPI app (api_service.py). Copy to api/.env and fill in.

# Supabase project (server-side: use the SERVICE ROLE key, not the anon key --
# the backend writes across users and must bypass RLS).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# LLM key (currently a Groq key). Used two ways: process_resumes.py points
# the `openai` SDK's client at Groq's OpenAI-compatible endpoint (base_url=
# https://api.groq.com/openai/v1) with this key; student/core/*_service.py
# uses the native `groq` SDK directly with the same key. One value, one var
# -- if the LLM provider ever changes, this is the only name to update.
LLM_API_KEY=your-groq-api-key

# Chat completion model, read by process_resumes.py (recruiter resume
# analysis) and student/core/groq_service.py + report_service.py (interview
# question generation, answer evaluation, session summaries). Was hardcoded
# per-file ("llama3-8b-8192", "mistral-saba-24b") until Groq decommissioned
# llama3-8b-8192 outright and broke every interview call with a
# model_decommissioned error. One shared var now -- the next retirement is
# an env var change here, not a code deploy. Check current model IDs at
# https://console.groq.com/docs/models before changing.
LLM_MODEL=llama-3.1-8b-instant

# Comma-separated list of origins allowed to call this API, e.g.
# "https://your-app.vercel.app,http://localhost:3000". Defaults to localhost
# only if unset -- set this to your deployed frontend's real origin, or the
# production frontend will be blocked by CORS.
ALLOWED_ORIGINS=http://localhost:3000
